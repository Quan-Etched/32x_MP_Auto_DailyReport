# Copy to .env and fill in. .env is gitignored — never commit a real key.
#
#   cp .env.example .env && $EDITOR .env
#
# The key is read from the environment by src/factory/config.py. It is used only
# by the Python ETL; it is never written into the dashboard bundle.

EOS_API_KEY=

# Optional overrides (defaults shown)
# EOS_BASE_URL=https://eos.core.etched.com/api/external/v1/test-logs
# FACTORY_TZ=America/Los_Angeles
# FACTORY_LEVEL=l10

# Where `make publish` puts the dashboard. Set it on a host that serves the
# site itself and publishing becomes a copy into that directory; leave it unset
# on a laptop and publishing force-pushes to the gh-pages branch instead.
# FACTORY_WEB_ROOT=/var/www/32x-production

# Extra TLS trust anchors. The EOS host uses Etched's internal CA, which is in
# no public trust store, so `make trust` writes certs/etched-internal-ca.pem and
# that path is picked up automatically. Set this only to point somewhere else.
# EOS_CA_BUNDLE=/path/to/ca-bundle.pem
