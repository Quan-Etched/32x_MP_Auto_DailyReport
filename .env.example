# Copy to .env and fill in. .env is gitignored — never commit a real key.
#
#   cp .env.example .env && $EDITOR .env
#
# The key is read from the environment by src/factory/config.py. It is used only
# by the Python ETL; it is never written into the dashboard bundle.

EOS_API_KEY=

# Optional overrides (defaults shown)
# EOS_BASE_URL=https://eos.core.etched.com/api/external/v1/test-logs
# FACTORY_TZ=America/Los_Angeles
# FACTORY_LEVEL=l10

# pega3 (ESVM), the station controller. It is the only source of the slot ->
# DUT serial map, so the daily tracker names units instead of chips. Read-only
# and unauthenticated; set FACTORY_PEGA=0 to switch the integration off, or
# point FACTORY_PEGA_URL elsewhere. If pega3 is unreachable the tracker falls
# back to per-chip verdicts from EOS.
# FACTORY_PEGA=1
# FACTORY_PEGA_URL=http://pega3:3000

# Where `make publish` puts the dashboard. Set it on a host that serves the
# site itself and publishing becomes a copy into that directory; leave it unset
# on a laptop and publishing force-pushes to the gh-pages branch instead.
# FACTORY_WEB_ROOT=/var/www/32x-production

# Extra TLS trust anchors. The EOS host uses Etched's internal CA, which is in
# no public trust store, so `make trust` writes certs/etched-internal-ca.pem and
# that path is picked up automatically. Set this only to point somewhere else.
# EOS_CA_BUNDLE=/path/to/ca-bundle.pem

# --- shopfloor traceability (src/shopfloor) ---------------------------------
# The pega-sfis receiver holds Pega's genealogy and route events. It reuses
# EOS_API_KEY above for the test-record half, which is the point of these two
# tools sharing a repo: one key, one place to rotate it.

# A read-only token is the right credential -- unlike the write API_TOKEN and
# unlike basic auth it cannot POST a payload. Ask Krish for an APP_TOKENS entry
# on the receiver; until then, basic auth below.
# SFIS_TOKEN=
SFIS_USER=etched
SFIS_PASSWORD=

# Defaults to https://pega-sfis with verification off -- the cert is self-signed
# and the Tailnet is what authenticates the host. http://pega-sfis:42891 also works.
# SFIS_BASE=https://pega-sfis
# SFIS_VERIFY=0

# How far back to ask EOS for test runs when mirroring.
# SHOPFLOOR_EOS_DAYS=120

# Morning standup markdown (`make daily-report`). Product is the title prefix;
# master Jira is the campaign ticket that sits under Test Tracker.
# FACTORY_REPORT_PRODUCT=A03 Sohu Module
# FACTORY_MASTER_JIRA=ETCH-42215

# `make file-bugs CREATE=1` opens one Bug per failing test case under this
# epic. The token is an Atlassian API token (id.atlassian.com), not a password.
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# JIRA_EPIC=ETCH-44407
# JIRA_ISSUE_TYPE=Bug
# Occurrence rows are written to daily/bug-drafts/*.csv. The bug names that
# file. A server URL can replace it later via occurrencesUrl.
