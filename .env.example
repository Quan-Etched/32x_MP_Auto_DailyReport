# Copy to .env (chmod 600) on the host that runs the mirror. Never commit .env.

# --- pega-sfis (the TY2 receiver) --------------------------------------------
# A read-only token is the right credential: unlike the write API_TOKEN and
# unlike basic auth it cannot POST a payload. Ask Krish to add one to the
# receiver's APP_TOKENS.
# SFIS_TOKEN=

# Basic auth is the fallback. The receiver ships built-in app users; use a real
# APP_USERS entry rather than a built-in on anything that runs unattended.
SFIS_USER=etched
SFIS_PASSWORD=

# Default https://pega-sfis with verification off — the cert is self-signed and
# the Tailnet is what authenticates the host. http://pega-sfis:42891 also works.
# SFIS_BASE=https://pega-sfis
# SFIS_VERIFY=0

# --- EOS test-log API --------------------------------------------------------
# Needed for the Etched-side test records (MLT/HTT/SLT/L10/L11). Without it the
# graph still builds: every part is marked source-unavailable instead of tested.
EOS_API_KEY=
# Etched's internal PKI is in no public trust store. Analysis/certs already has
# the bundle; point at it rather than copying it.
EOS_CA_BUNDLE=/Users/chuck/project/Analysis/certs/etched-internal-ca.pem

# --- optional ----------------------------------------------------------------
# ESVM controllers, the only source of slot -> unit SN inside a fixture run.
# PEGA_HOSTS=pega3,pega4,pega5
# Station registry reused from Analysis instead of copied.
# ANALYSIS_SRC=/Users/chuck/project/Analysis/src
# SHOPFLOOR_EOS_DAYS=120
