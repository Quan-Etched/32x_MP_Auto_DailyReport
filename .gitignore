# Secrets — never commit the EOS API key
.env

# Fetched payloads (EOS + pega3), generated metrics and scheduler logs
data/raw/
data/processed/
data/logs/
dashboard/data/*.js
dashboard/data/releases/
!dashboard/data/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# macOS
.DS_Store

# Fetched CA bundle (public certs, but machine-local — refetch with `make trust`)
certs/

# Shopfloor snapshots (raw pega-sfis + EOS responses) and the YAML rendered from
# them. Both are regenerable -- `make sfis-mirror` then `make sfis-unit` -- and a
# snapshot is ~1.5 MB per 4U node, so committing them would grow the repo by that
# much every time anyone investigated a unit. The snapshot is local insurance
# against pega-sfis being unreachable, not a shared artifact.
snapshots/
out/

# SiVal, checked out here for reference. It is its own repository
# (github.com/etched-ai/sival) with its own remote and history, and committing
# it into this one would vendor 70 MB of somebody else's project and detach it
# from its upstream. src/factory/chip_collect.py reads SiVal over its HTTP API,
# not off this path, so nothing here depends on the checkout existing.
sival/
